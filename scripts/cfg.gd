extends RefCounted
## Все настройки прототипа в одном месте. Меняйте числа здесь, чтобы настроить баланс игры.
## Все размеры, расстояния и скорости — в пикселях базового разрешения 1080×1920.

# Размер игрового поля (вертикальный экран телефона, 9:16)
const W := 1080.0
const H := 1920.0
# Масштаб рисунка серферов, акул и сундука (их фигуры заданы для поля 720×1280)
const ART_SCALE := 1.5

# Полосы: у каждого игрока своя полоса и свой лежак
const LANES := 5
const LANE_W := W / LANES
const PLAYER_LANE := 2  # игрок в центральной полосе, остальные — боты
const SURFER_COLORS := [Color(0.9, 0.3, 0.3), Color(0.3, 0.75, 0.35), Color(1.0, 0.55, 0.1), Color(0.6, 0.35, 0.85), Color(0.95, 0.4, 0.7)]
const BOT_NAMES := ["Бот Макс", "Бот Аня", "ТЫ", "Бот Лёха", "Бот Катя"]

# Геометрия пляжа (координата Y растёт вниз)
const SHORE_Y := 1626.0    # линия прибоя (пляж — 294 px от низа экрана)
const LOUNGER_Y := 1784.0  # где стоит серфер на лежаке (разбег до воды — 158 px)

# Зоны доходности: от берега к валу, очки в секунду.
# ZONE_HEIGHTS — высота каждой зоны (px) в начале раунда, снизу вверх.
# Три верхние (x32, x64, x128) — хардкорные: в начале раунда они выше края экрана,
# камера показывает их, когда игрок заплывает туда.
# Когда вал движется, доходные зоны сохраняют свою высоту и едут к берегу вместе с ним,
# а нижние сжимаются и исчезают по очереди: сначала x1, потом x2 и т.д.
const ZONES := 8
# x1 — узкая полоска у берега, дальше каждая зона на ~24 px выше предыдущей, x128 — самая широкая.
const ZONE_HEIGHTS := [119.0, 238.0, 262.0, 286.0, 310.0, 333.0, 357.0, 380.0]
const ZONE_POINTS := [1, 2, 4, 8, 16, 32, 64, 128]
const ZONE_COLORS := [
	Color(0.5, 0.83, 0.9), Color(0.31, 0.7, 0.85), Color(0.18, 0.56, 0.77), Color(0.12, 0.42, 0.65),
	Color(0.08, 0.28, 0.5),
	Color(0.2, 0.17, 0.45), Color(0.3, 0.1, 0.38), Color(0.42, 0.06, 0.2),  # хардкор: фиолетовый → бордовый
]
# Прогрессивные очки: базовая ставка (очков/с) плавно растёт за матч [в начале, в конце]
# и умножается на множитель зоны. Например, в x128 в конце матча — 5 × 128 = 640 очков/с.
const POINTS_RATE := [1.0, 5.0]

# Вал волн: в начале стоит над всеми зонами (выше экрана) и начинает опускаться сразу после «GO!».
# WALL_START_Y = SHORE_Y − сумма ZONE_HEIGHTS (1626 − 2285 = −659).
# Скорость плавно растёт от WALL_SPEED_START до WALL_SPEED_MAX за WALL_RAMP_TIME секунд, дальше постоянная.
# 50 секунд из 90 = максимальная скорость, когда на таймере «40».
const WALL_SPEED_START := 0.0
const WALL_SPEED_MAX := 34.0
const WALL_RAMP_TIME := 50.0
const WALL_START_Y := -659.0
const WALL_END_Y := 1536.0  # к концу раунда вал останавливается в 90 px от берега
const WALL_GAP := 45.0     # ближе этого к валу подплыть нельзя
const WALL_TOUCH_LIMIT := 0.6  # сколько секунд в сумме за раунд можно касаться вала
const ROUND_TIME := 90.0

# Камера следит за игроком: плавно поднимается, когда он заплывает выше, и опускается обратно.
const CAM_PLAYER_AT := 0.6      # где на экране держать игрока в воде (0 — верх, 1 — низ)
const CAM_SMOOTH := 4.0         # плавность: больше — камера быстрее догоняет игрока
const CAM_WALL_MARGIN := 200.0  # сколько вала видно над водой, когда камера в самом верху
# Прицел бомбы у края экрана двигает камеру: чем ближе к краю, тем быстрее (до AIM_SCROLL_SPEED px/с).
const AIM_EDGE_TOP := 300.0     # зона у верхнего края (под панелью с таймером), px
const AIM_EDGE_BOTTOM := 250.0  # зона у нижнего края, px
const AIM_SCROLL_SPEED := 1400.0

# Золотая зона: временная полоса высотой как x16, появляется в случайном месте моря.
# Внутри неё всегда x256, в какой бы зоне она ни оказалась. Едет к берегу вместе с валом.
const GOLD_POINTS := 256
const GOLD_HEIGHT := 238.0
const GOLD_DURATION := 7.0
const GOLD_COUNT := [1, 2]  # сколько раз за матч [мин, макс]
const GOLD_COLOR := Color(1.0, 0.8, 0.15)

# Движение серфера (пикселей в секунду)
const BEACH_BACK := 225.0  # откат к лежаку на пляже (после воды)
const SWIM_SPEED := 225.0  # плывём от берега, пока палец на экране
const DRIFT_SPEED := 165.0 # сносит к берегу, когда палец отпущен

# Управление на пляже: держишь палец — бежишь к воде с этой скоростью.
const BEACH_RUN_SPEED := 300.0

# Управление в воде:
# держишь палец на море — плывёшь к валу и плавно разгоняешься до SWIM_ACCEL_MAX за SWIM_ACCEL_TIME секунд;
# держишь палец на пляже (нижней полосе) — так же разгоняешься к берегу;
# отпустил — сразу обычный снос к берегу, разгон сбрасывается.
const SWIM_ACCEL_MAX := 1.7
const SWIM_ACCEL_TIME := 1.2
# Свайп вверх — рывок вперёд, свайп вниз — рывок назад (≈ DASH_SPEED / DASH_DECAY = 175 px).
const DASH_SPEED := 1050.0      # начальная скорость рывка, px/с
const DASH_DECAY := 6.0         # как быстро гаснет рывок
const DASH_COOLDOWN := 0.8      # пауза между рывками, сек
const SWIPE_MIN_DIST := 90.0    # насколько провести пальцем, чтобы это считалось свайпом, px
const SWIPE_MAX_TIME := 0.35    # ...и не дольше, чем за столько секунд

# ---------------- Сложность ----------------
# Сложность растёт от 0 (старт) до 1 (пик) за DIFFICULTY_PEAK_TIME секунд и дальше держится на пике.
# 50 секунд из 90 = пик, когда на таймере остаётся «40».
# DIFFICULTY_CURVE: 1 = ровный рост, >1 = медленный старт и быстрый рост в конце, <1 = наоборот.
const DIFFICULTY_PEAK_TIME := 50.0
const DIFFICULTY_CURVE := 1.0
# Каждая пара ниже — [в начале, на пике]; между ними значение плавно меняется вместе со сложностью.

# ---------------- Акулы: сколько и где ----------------
# Квота — сколько акул одновременно держится в каждой зоне (x1 … x128).
# Новая акула появляется в той зоне, где сильнее всего не хватает до квоты.
const SHARK_QUOTA_START := [1, 1, 2, 2, 2, 3, 4, 5]
const SHARK_QUOTA_PEAK := [2, 2, 4, 3, 4, 5, 5, 6]
const ZONE_MIN_HEIGHT := 75.0  # зона, сжатая валом ниже этой высоты (px), остаётся без акул — они уходят вглубь
const SHARK_SPAWN_INTERVAL := [1.0, 0.5]  # пауза между появлениями акул, сек

# ---------------- Акулы: скорость ----------------
const SHARK_SPEEDS := [52.5, 82.5, 150.0]  # медленная, средняя, быстрая (px/с)
# Доли типов (примерные проценты): [медленная, средняя, быстрая]
const SHARK_TYPE_WEIGHTS_START := [20, 70, 10]
const SHARK_TYPE_WEIGHTS_PEAK := [10, 55, 35]
# Характер зон: множители долей [медленная, средняя, быстрая] для каждой зоны.
# Внизу больше медленных, у вала — больше быстрых.
const SHARK_TYPE_ZONE_FACTOR := [
	[2.0, 1.0, 0.3],  # x1
	[1.5, 1.0, 0.6],  # x2
	[1.0, 1.0, 1.0],  # x4
	[0.6, 1.0, 1.5],  # x8
	[0.4, 1.0, 2.0],  # x16
	[0.3, 1.0, 2.5],  # x32
	[0.2, 1.0, 3.0],  # x64
	[0.1, 1.0, 3.5],  # x128
]
const SHARK_SPEED_SPREAD := 0.08  # разброс скорости внутри типа (±8%)

# ---------------- Акулы: траектории ----------------
# Доля «хитрых» (не прямых) траекторий: [в начале, на пике], умножается на коэффициент зоны.
const SHARK_TRICKY_SHARE := [0.15, 0.45]
const SHARK_TRICKY_ZONE_FACTOR := [0.5, 0.7, 1.0, 1.3, 1.5, 1.7, 1.9, 2.0]
# Какие хитрые траектории в какой зоне: [волна, диагональ, зигзаг, петли, рывки].
# Внизу — плавные, у вала — резкие и непредсказуемые.
const SHARK_TRICKY_PATTERNS := [
	[1.0, 1.0, 0.0, 0.0, 0.0],  # x1
	[1.0, 1.0, 0.3, 0.0, 0.0],  # x2
	[1.0, 1.0, 1.0, 0.5, 0.5],  # x4
	[0.5, 0.5, 1.0, 1.0, 1.0],  # x8
	[0.3, 0.3, 1.0, 1.0, 1.0],  # x16
	[0.2, 0.3, 1.0, 1.2, 1.2],  # x32
	[0.1, 0.3, 1.0, 1.4, 1.4],  # x64
	[0.1, 0.2, 1.0, 1.5, 1.6],  # x128
]

# ---------------- Акулы: предупреждение и укусы ----------------
# Цикл акулы: тень (спокойно) -> пузыри -> плавник -> полная видимость (кусает) -> тень.
const SHARK_CALM_TIME := [[2.5, 4.5], [1.0, 2.0]]  # сколько акула «спит» в тени: [мин, макс] в начале и на пике
const SHARK_BUBBLES_TIME := [1.2, 0.6]  # предупреждение «пузыри»
const SHARK_FIN_TIME := [1.2, 0.6]      # предупреждение «плавник»
const SHARK_BITE_TIME := [1.43, 1.65]   # сколько акула видна полностью и кусает
const BITE_RADIUS := 63.0
const BOT_DANGER_DIST := 195.0

# ---------------- Торнадо ----------------
# Красная полоса постоянно лежит на границе зон x32 и x64 (едет к берегу вместе с ними).
# Вдоль неё то и дело проносятся торнадо: кто в воде на полосе и попал под воронку — погибает.
# Скорость и частота плавно растут за матч: [в начале, в конце].
const TORNADO_SPEED := [230.0, 350.0]   # px/с
const TORNADO_INTERVAL := [3.0, 0.6]    # пауза между торнадо, сек (1 раз в 3 с → 5 раз в 3 с)
const TORNADO_FIRST_DELAY := 3.0        # первое торнадо — через столько секунд после «GO!»
const TORNADO_WARN := 0.6               # сколько секунд мигает стрелка у края перед вылетом
const TORNADO_BAND := 54.0              # толщина полосы, px (как акула)
const TORNADO_RADIUS := 48.0            # ширина воронки: насколько близко по горизонтали задевает

# ---------------- Большая акула (ивент) ----------------
# В 3 раза больше обычной. Два состояния: тень под водой (безопасна) и прыжок из воды с открытой пастью
# (кусает всех в овальной зоне). Перед прыжком тень темнеет и видна красная зона укуса.
# Одновременно — не больше одной. Над полосой торнадо (x64, x128) появляется чаще.
const BIG_SHARK_SCALE := 3.0               # во сколько раз больше обычной акулы
const BIG_SHARK_INTERVAL := [12.0, 6.0]    # пауза между появлениями, сек [в начале, на пике]
const BIG_SHARK_FIRST_DELAY := 8.0         # первая — не раньше, чем через столько секунд после «GO!»
const BIG_SHARK_ZONE_WEIGHTS := [1, 1, 1, 1, 1, 1, 3, 3]  # шанс зоны: x64 и x128 (за торнадо) — втрое выше
const BIG_SHARK_SPEED := 70.0              # px/с
const BIG_SHARK_SHADOW_TIME := [[3.0, 4.5], [1.8, 3.0]]  # сколько плывёт тенью [мин, макс] в начале и на пике
const BIG_SHARK_WARN := 0.7                # последние секунды тени: темнеет и показывает зону укуса
const BIG_SHARK_JUMP_TIME := 0.9           # сколько длится прыжок (опасная фаза)
# Зона укуса — овал. Соседние дорожки в 216 px друг от друга: по ширине 420 px акула достаёт
# сразу трёх серферов, только если прыгнет точно над средним из трёх соседей.
const BIG_SHARK_HIT_RX := 210.0
const BIG_SHARK_HIT_RY := 75.0
const BOT_BIG_SHARK_DIST := 320.0          # с какого расстояния бот уплывает от большой акулы

# ---------------- Молния (ивент) ----------------
# Работает как бомба, но бьёт сама и только в зонах выше полосы торнадо (x64, x128).
# Сначала на месте удара светится круг и кольцо сжимается к центру, потом бьёт молния:
# все в воде внутри круга погибают (игрок тоже).
const LIGHTNING_INTERVAL := [4.0, 1.5]   # пауза между ударами, сек [в начале, на пике]
const LIGHTNING_FIRST_DELAY := 6.0       # первый удар — не раньше, чем через столько секунд после «GO!»
const LIGHTNING_WARN := 1.0              # сколько секунд виден круг до удара
const LIGHTNING_RADIUS := 83.0           # радиус удара, px (как у бомбы)
const LIGHTNING_AIM_CHANCE := 0.5        # доля ударов, нацеленных в серфера (остальные — в случайное место)
const LIGHTNING_COLOR := Color(1.0, 0.95, 0.45)

# Бомба: пока игрок на лежаке (или погиб), у него есть кнопка «Бомба». Нажал — выбираешь любое место в море
# (не на пляже), туда через BOMB_FALL_TIME падает бомба. Попал по противнику — он погибает,
# а игрок получает BOMB_COST × BOMB_REWARD_MULT очков за каждого.
const BOMB_COST := 40           # сколько сохранённых очков стоит бросок
const BOMB_REWARD_MULT := 3     # награда за попадание: ×3 от стоимости
# После гибели бомбу тоже можно бросать: стоит ×2 (80), а за попадание даёт ×4 от этой цены (320).
const BOMB_DEAD_COST_MULT := 2
const BOMB_DEAD_REWARD_MULT := 4
const BOMB_COOLDOWN := 2.0      # пауза между бросками, сек
const BOMB_FALL_TIME := 1.0     # сколько секунд бомба летит — время увернуться
const BOMB_RADIUS := 83.0       # радиус взрыва, px
# Боты тоже бросают бомбы (с лежака или после гибели), в том числе в игрока.
const BOT_BOMB_CHANCE := 0.35   # шанс броска в секунду, когда бот может бросить
const BOT_BOMB_AIM_ERROR := 68.0  # ошибка прицела бота, px

# Очки, набранные в воде, — временные: сохраняются, когда серфер возвращается на лежак
# (и у выживших в конце раунда). При гибели в воде сгорает эта доля временных очков, остальное идёт в счёт.
const DEATH_PENALTY := 0.7

# Жизни: после гибели серфер через RESPAWN_DELAY секунд снова появляется на лежаке.
# Когда жизни кончились — выбывает до конца раунда.
const LIVES := 3
const RESPAWN_DELAY := 5.0

# Сундук
const CHEST_REWARD_MULT := 4   # награда = очки/с в зоне x128 прямо сейчас × 4 (512 в начале матча, 2560 в конце)
const CHEST_LIFE := 6.0
# Паузы до появления сундука, сек [мин, макс]. Вдвое чаще прежнего: в среднем раз в 7 с (≈12 за матч).
const CHEST_FIRST_DELAY := [3.0, 5.0]   # до первого сундука после «GO!»
const CHEST_INTERVAL := [5.5, 8.5]      # между появлениями (не ждёт, пока прошлый сундук исчезнет)

# Кубок: кто первый тапнет — 5 секунд бессмертия (не страшны акулы, вал, торнадо, молния, бомбы, ракеты).
# Появляется в 1,5 раза реже прежних сундуков; следующий — только после того, как прошлый исчез.
const TROPHY_LIFE := 6.0
const TROPHY_INVULN := 5.0
const TROPHY_FIRST_DELAY := [7.5, 12.0]
const TROPHY_INTERVAL := [10.5, 16.5]   # пауза после исчезновения прошлого кубка

# Ракеты: покупаются кнопкой на пляже (до ROCKET_MAX за раз), в воде свайп влево/вправо — выстрел.
# Ракета летит по горизонтали и уничтожает первую активную (кусающую) акулу или соперника на пути.
const ROCKET_COST := 100
const ROCKET_MAX := 3
const ROCKET_START := 3         # с этим набором ракет игрок начинает раунд
const ROCKET_SPEED := 715.0     # px/с
const ROCKET_HIT := 45.0        # насколько близко должна пройти ракета, чтобы попасть, px

# Призы за 1, 2 и 3 место (монеты)
const PRIZES := [100, 50, 25]


static func lane_x(lane: int) -> float:
	return LANE_W * (lane + 0.5)
